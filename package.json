{
  "name": "session-store-development",
  "private": true,
  "description": "The development tools of the repository: the shared tools of polyspec (@polyspec/kit), whose check-documents and documents-stamp read and stamp the documents, and binding (@polyspec/binding), which checks the contract and writes the bindings",
  "license": "MIT",
  "workspaces": [
    "packages/ts"
  ],
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.2.0",
      "onFail": "error"
    }
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.12",
    "@polyspec/binding": "https://github.com/polyspec/binding/releases/download/v0.0.17/polyspec-binding-0.0.17.tgz",
    "@polyspec/kit": "https://github.com/polyspec/kit/releases/download/v0.0.119/polyspec-kit-0.0.119.tgz",
    "@polyspec/php-serialization": "https://github.com/polyspec/php-serialization/releases/download/v0.0.15/polyspec-php-serialization-0.0.15.tgz",
    "typescript": "7.0.2"
  }
}
